<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HoverPeek.App">
    <Style x:Key="Hp.SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hp.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Hp.SettingRow" TargetType="Border">
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="Hp.RowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Hp.RowDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,20,0"/>
    </Style>

    <Style x:Key="Hp.ValidationText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Danger}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hp.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hp.Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom"
                                    Background="Transparent" CornerRadius="0,0,4,4"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusLine" Property="Background" Value="{DynamicResource Hp.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:NumericField" BasedOn="{StaticResource Hp.TextBox}">
        <Setter Property="Width" Value="90"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Style.Triggers>
            <Trigger Property="IsValueValid" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Hp.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hp.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20">
                        <Border x:Name="Track" Background="{DynamicResource Hp.Canvas}"
                                BorderBrush="{DynamicResource Hp.Stroke}" BorderThickness="1" CornerRadius="10"/>
                        <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3"
                                 HorizontalAlignment="Left" Fill="{DynamicResource Hp.TextSecondary}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Hp.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Hp.Accent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Hp.Surface}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hp.HoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hp.SelectedFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hp.Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Hp.ComboBoxItem}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <!-- 這是 ToggleButton 的樣板，TemplateBinding 會綁到 ToggleButton（Padding=0），要往上取 ComboBox 的 -->
                                        <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 前景色要明確綁 ComboBox：否則繼承 ToggleButton 的系統預設黑色，深色主題下看不見 -->
                                            <ContentPresenter Grid.Column="0" Margin="2,0,5,0"
                                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{DynamicResource Hp.IconFont}"
                                                       Foreground="{DynamicResource Hp.TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Hp.TextBox}"
                                 Margin="1,1,28,1" Padding="7,4" BorderThickness="0"
                                 Background="{DynamicResource Hp.Canvas}" Visibility="Hidden"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Hp.SurfaceAlt}" BorderBrush="{DynamicResource Hp.Stroke}"
                                    BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260" Margin="0,3,0,0">
                                <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Hp.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.NavList" TargetType="ListBox">
        <!-- 日文等較長的分頁名稱不要撐出橫向捲軸 -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,10"/>
    </Style>

    <Style x:Key="Hp.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="18" HorizontalAlignment="Left"
                                    Background="Transparent" CornerRadius="2"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hp.HoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hp.SelectedFill}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Hp.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.StandardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hp.Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Hp.HoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Hp.PressedFill}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Hp.StandardButton}">
        <Setter Property="Background" Value="{DynamicResource Hp.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hp.Surface}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
