<Window x:Class="HoverPeek.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HoverPeek.App"
        xmlns:loc="clr-namespace:HoverPeek.Core.Localization;assembly=HoverPeek.Core"
        Title="{x:Static loc:Strings.SettingsWindowTitle}"
        Width="760" Height="540" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Hp.Surface}" FontFamily="{DynamicResource Hp.UiFont}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Hp.SurfaceAlt}"
                BorderBrush="{DynamicResource Hp.Stroke}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavigationList" Style="{StaticResource Hp.NavList}"
                     ItemContainerStyle="{StaticResource Hp.NavItem}" SelectionChanged="OnNavigationSelectionChanged">
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE8B0;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.TabHoverBehavior}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE737;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.TabPreviewWindow}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xEB9F;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.SectionImage}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE8A5;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.SectionText}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE714;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.SectionVideo}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xF012;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.SectionArchive}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.SectionGeneral}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Hp.Icon}" Text="&#xE946;" Margin="0,0,12,0"/><TextBlock Text="{x:Static loc:Strings.TabAbout}" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            </ListBox>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="SectionTitle" Margin="24,20,24,14" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Text}"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
                <Grid Margin="24,0,20,20">
                    <StackPanel x:Name="HoverSection">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelHoverDelay}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescHoverDelay}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="HoverDelayField"/><TextBlock Text="{x:Static loc:Strings.UnitMilliseconds}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=HoverDelayField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelJitterTolerance}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescJitterTolerance}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="JitterToleranceField"/><TextBlock Text="{x:Static loc:Strings.UnitPixels}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=JitterToleranceField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelAutoCloseDelay}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescAutoCloseDelay}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="AutoCloseDelayField"/><TextBlock Text="{x:Static loc:Strings.UnitMilliseconds}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=AutoCloseDelayField}"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="WindowSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelWindowWidth}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescWindowWidth}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="WindowWidthField"/><TextBlock Text="{x:Static loc:Strings.UnitPixels}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=WindowWidthField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelWindowHeight}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescWindowHeight}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="WindowHeightField"/><TextBlock Text="{x:Static loc:Strings.UnitPixels}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=WindowHeightField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelCenterWindow}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescCenterWindow}"/></StackPanel><CheckBox x:Name="CenterWindowToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelFadeInDuration}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescFadeInDuration}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="FadeInDurationField"/><TextBlock Text="{x:Static loc:Strings.UnitMilliseconds}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=FadeInDurationField}"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ImageSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelImageMaxDimension}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescImageScale}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="ImageMaxDimensionField"/><TextBlock Text="{x:Static loc:Strings.UnitPixels}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=ImageMaxDimensionField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelEnableGifAnimation}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescGifStatic}"/></StackPanel><CheckBox x:Name="EnableGifAnimationToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelShowQuickThumbnail}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescShowQuickThumbnail}"/></StackPanel><CheckBox x:Name="ShowQuickThumbnailToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="TextSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelTextMaxFileSize}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescTextMaxFileSize}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="TextMaxFileSizeField"/><TextBlock Text="{x:Static loc:Strings.UnitMegabytes}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=TextMaxFileSizeField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelTextMaxLines}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescTextMaxLines}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="TextMaxLinesField"/><TextBlock Text="{x:Static loc:Strings.UnitLines}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=TextMaxLinesField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelTextFontSize}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescTextFontSize}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><local:NumericField x:Name="TextFontSizeField"/><TextBlock Text="{x:Static loc:Strings.UnitPoints}" Foreground="{DynamicResource Hp.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hp.ValidationText}" Text="{Binding ValidationMessage, ElementName=TextFontSizeField}"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelTextFontFamily}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescTextFontFamily}"/></StackPanel><ComboBox x:Name="TextFontFamilyCombo" Grid.Column="1" Style="{StaticResource Hp.ComboBox}" IsEditable="True" IsTextSearchEnabled="True"><ComboBoxItem Content="Cascadia Mono, Consolas"/><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="JetBrains Mono"/><ComboBoxItem Content="Courier New"/></ComboBox></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelEnableMarkdownRendering}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescMarkdownRendering}"/></StackPanel><CheckBox x:Name="EnableMarkdownRenderingToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelEnableSyntaxHighlighting}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescSyntaxHighlighting}"/></StackPanel><CheckBox x:Name="EnableSyntaxHighlightingToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="VideoSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelVideoAutoPlay}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescVideoThumbnail}"/></StackPanel><CheckBox x:Name="VideoAutoPlayToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelVideoMuted}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescVideoMuted}"/></StackPanel><CheckBox x:Name="VideoMutedToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ArchiveSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelArchiveAutoExpand}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescArchiveAutoExpand}"/></StackPanel><CheckBox x:Name="ArchiveAutoExpandToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border></Border>
                    </StackPanel>

                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}"><StackPanel>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelStartWithWindows}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescStartup}"/></StackPanel><CheckBox x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource Hp.ToggleSwitch}" VerticalAlignment="Center"/></Grid></Border>
                            <Border Height="1" Background="{DynamicResource Hp.Stroke}"/>
                            <Border Style="{StaticResource Hp.SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.LabelLanguage}"/><TextBlock Style="{StaticResource Hp.RowDescription}" Text="{x:Static loc:Strings.DescLanguage}"/></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource Hp.ComboBox}"/></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Hp.SettingsCard}" Padding="20"><StackPanel>
                            <TextBlock x:Name="AboutAppName" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Text}"/>
                            <TextBlock x:Name="AboutVersion" FontSize="13" Foreground="{DynamicResource Hp.TextSecondary}" Margin="0,3,0,16"/>
                            <TextBlock Text="{x:Static loc:Strings.AboutDescription}" FontSize="13" Foreground="{DynamicResource Hp.Text}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.AboutAuthorLabel}" Margin="0,0,0,9"/><TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource Hp.Text}" Text="{x:Static loc:Strings.AboutAuthorValue}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.AboutGitHubLabel}" Margin="0,0,0,9"/><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,9"><Hyperlink NavigateUri="https://github.com/kyosora/HoverPeek" RequestNavigate="OnHyperlinkNavigate" Foreground="{DynamicResource Hp.Accent}"><TextBlock Text="{x:Static loc:Strings.AboutGitHubValue}"/></Hyperlink></TextBlock>
                                <TextBlock Grid.Row="2" Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.AboutLicenseLabel}" Margin="0,0,0,9"/><TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Hp.Text}" Text="{x:Static loc:Strings.AboutLicenseValue}"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Hp.RowLabel}" Text="{x:Static loc:Strings.AboutFrameworkLabel}"/><TextBlock x:Name="AboutFramework" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource Hp.Text}"/>
                            </Grid>
                            <WrapPanel Margin="0,20,0,0"><Button Style="{StaticResource Hp.StandardButton}" Content="{x:Static loc:Strings.ButtonOpenSettingsFolder}" Click="OnOpenSettingsFolderClick" Margin="0,0,8,8"/><Button Style="{StaticResource Hp.StandardButton}" Content="{x:Static loc:Strings.ButtonOpenLogFolder}" Click="OnOpenLogFolderClick" Margin="0,0,0,8"/></WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Hp.Stroke}" BorderThickness="0,1,0,0" Background="{DynamicResource Hp.Surface}" Padding="14,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource Hp.SubtleButton}" Content="{x:Static loc:Strings.ButtonReset}" Click="OnResetClick"/>
                <TextBlock x:Name="SaveErrorText" Grid.Column="1" Foreground="{DynamicResource Hp.Danger}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource Hp.StandardButton}" Content="{x:Static loc:Strings.ButtonCancel}" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0"/><Button x:Name="SaveButton" Style="{StaticResource Hp.PrimaryButton}" Content="{x:Static loc:Strings.ButtonSave}" IsDefault="True" Click="OnSaveClick"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
