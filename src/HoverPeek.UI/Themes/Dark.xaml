<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 色票參考 Windows 11 Fluent 深色主題的中性色 -->
    <Color x:Key="Hp.SurfaceColor">#202020</Color>
    <SolidColorBrush x:Key="Hp.Surface" Color="{StaticResource Hp.SurfaceColor}"/>
    <SolidColorBrush x:Key="Hp.SurfaceAlt" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Hp.Canvas" Color="#171717"/>
    <SolidColorBrush x:Key="Hp.Stroke" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Hp.Text" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Hp.TextSecondary" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Hp.TextTertiary" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="Hp.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Hp.HoverFill" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="Hp.PressedFill" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Hp.SelectedFill" Color="#2E60CDFF"/>
    <SolidColorBrush x:Key="Hp.Danger" Color="#FF99A4"/>
    <SolidColorBrush x:Key="Hp.BadgeFill" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="Hp.ScrollThumbFill" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Hp.Document" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Hp.DocumentText" Color="#E8E8E8"/>
    <!-- AvalonEdit 的語法高亮配色是為白底設計的，程式碼區塊在深色主題下仍用淺底，避免藍色關鍵字看不清 -->
    <SolidColorBrush x:Key="Hp.CodeDocument" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Hp.CodeLineNumbers" Color="#9A9A9A"/>
</ResourceDictionary>
