<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 色票參考 Windows 11 Fluent 淺色主題的中性色 -->
    <Color x:Key="Hp.SurfaceColor">#FBFBFB</Color>
    <SolidColorBrush x:Key="Hp.Surface" Color="{StaticResource Hp.SurfaceColor}"/>
    <SolidColorBrush x:Key="Hp.SurfaceAlt" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Hp.Canvas" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Hp.Stroke" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="Hp.Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Hp.TextSecondary" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="Hp.TextTertiary" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Hp.Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="Hp.HoverFill" Color="#0F000000"/>
    <SolidColorBrush x:Key="Hp.PressedFill" Color="#18000000"/>
    <SolidColorBrush x:Key="Hp.SelectedFill" Color="#1F005FB8"/>
    <SolidColorBrush x:Key="Hp.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Hp.BadgeFill" Color="#14000000"/>
    <SolidColorBrush x:Key="Hp.ScrollThumbFill" Color="#66000000"/>
    <SolidColorBrush x:Key="Hp.Document" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hp.DocumentText" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Hp.CodeDocument" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hp.CodeLineNumbers" Color="#9A9A9A"/>
</ResourceDictionary>
