<Window x:Class="HoverPeek.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:loc="clr-namespace:HoverPeek.Core.Localization;assembly=HoverPeek.Core"
        Title="HoverPeek"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="800"
        Height="600"
        UseLayoutRounding="True"
        Background="{DynamicResource Hp.Surface}"
        FontFamily="{DynamicResource Hp.UiFont}">

    <!-- 不用 AllowsTransparency：WebView2 在透明視窗裡不會顯示，圓角與陰影交給 DWM -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 標題列 -->
        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Padding="12,8,12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Hp.Stroke}"
                Background="{DynamicResource Hp.SurfaceAlt}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource Hp.SubtleButton}"
                        Padding="6"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        ToolTip="{x:Static loc:Strings.FolderBack}"
                        Click="OnBackClick">
                    <TextBlock Style="{StaticResource Hp.Icon}" FontSize="14" Text="&#xE72B;"
                               Foreground="{DynamicResource Hp.Text}"/>
                </Button>

                <TextBlock x:Name="HeaderIcon"
                           Grid.Column="1"
                           Style="{StaticResource Hp.Icon}"
                           FontSize="20"
                           Margin="0,0,10,0"
                           Text="&#xE8A5;"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Hp.Title}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="MetaText" Style="{StaticResource Hp.Caption}"/>
                        <Border x:Name="LowResBadge" Style="{StaticResource Hp.Badge}" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Hp.Caption}" FontSize="11"
                                       Text="{x:Static loc:Strings.BadgeLowRes}"/>
                        </Border>
                        <Border x:Name="TruncatedBadge" Style="{StaticResource Hp.Badge}" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Hp.Caption}" FontSize="11"
                                       Text="{x:Static loc:Strings.BadgeTruncated}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="ExpandButton"
                        Grid.Column="3"
                        Style="{StaticResource Hp.SubtleButton}"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="OnExpandClick"/>
            </Grid>
        </Border>

        <!-- 內容區：一次只顯示一個 -->
        <Grid x:Name="ContentHost" Grid.Row="1">

            <!-- 圖片 -->
            <Border x:Name="ImageHost" Background="{DynamicResource Hp.Canvas}" Visibility="Collapsed">
                <Image x:Name="ImageView"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="8"/>
            </Border>

            <!-- 壓縮檔／資料夾清單 + 右側圖片預覽 -->
            <Grid x:Name="ListHost" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*"/>
                    <ColumnDefinition x:Name="InnerImageColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="FileListView"
                          Grid.Column="0"
                          Margin="6,4,6,6"
                          Style="{StaticResource Hp.FileList}"
                          SelectionMode="Single"
                          MouseMove="OnFileListMouseMove"
                          MouseLeave="OnFileListMouseLeave"
                          MouseDoubleClick="OnFileListDoubleClick">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource Hp.ListHeader}">
                            <GridViewColumn Header="{x:Static loc:Strings.HeaderName}" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Hp.TextSecondary}"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static loc:Strings.HeaderSize}" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="70"
                                                   Foreground="{DynamicResource Hp.TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static loc:Strings.HeaderModified}" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedText}"
                                                   Foreground="{DynamicResource Hp.TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Column="1"
                        Background="{DynamicResource Hp.Canvas}"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource Hp.Stroke}">
                    <Image x:Name="InnerImageView"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="8"/>
                </Border>
            </Grid>

            <!-- 影片：海報放在 VideoView 的 Content（前景層），VLC 起播後隱藏 -->
            <vlc:VideoView x:Name="VideoPlayer" Visibility="Collapsed" Background="Black">
                <Image x:Name="PosterView" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </vlc:VideoView>

            <!-- 程式碼 -->
            <avalonEdit:TextEditor x:Name="CodeView"
                                   Visibility="Collapsed"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   Padding="8,6"
                                   Background="{DynamicResource Hp.CodeDocument}"
                                   LineNumbersForeground="{DynamicResource Hp.CodeLineNumbers}"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"/>

            <!-- Markdown -->
            <wv2:WebView2 x:Name="MarkdownView" Visibility="Collapsed"/>

            <!-- 載入中／不支援／錯誤 -->
            <StackPanel x:Name="MessageHost"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520"
                        Margin="24">
                <TextBlock x:Name="MessageIcon"
                           Style="{StaticResource Hp.Icon}"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="MessageTitle"
                           Style="{StaticResource Hp.Title}"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="None"/>
                <TextBlock x:Name="MessageBody"
                           Style="{StaticResource Hp.Caption}"
                           Margin="0,6,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="None"/>
                <Button x:Name="DetailsButton"
                        Style="{StaticResource Hp.SubtleButton}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Hp.Accent}"
                        Content="{x:Static loc:Strings.PreviewShowDetails}"
                        Visibility="Collapsed"
                        Click="OnDetailsClick"/>
                <TextBox x:Name="MessageDetail"
                         Visibility="Collapsed"
                         Margin="0,10,0,0"
                         MaxHeight="220"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Padding="8"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Hp.Canvas}"
                         Foreground="{DynamicResource Hp.TextSecondary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
